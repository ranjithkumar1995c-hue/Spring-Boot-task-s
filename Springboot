package newServlet;

import java.io.IOException;
import java.io.PrintWriter;

import jakarta.servlet.Servlet;
import jakarta.servlet.ServletConfig;
import jakarta.servlet.ServletException;
import jakarta.servlet.ServletRequest;
import jakarta.servlet.ServletResponse;
 
public class MyServlet implements Servlet {
	
//	1. init()-> used only once in entire program => to start the program
	
	
	ServletConfig config;
	@Override
	public void init(ServletConfig config) throws ServletException {
		 this.config=config;
		 System.out.println("Servlet Initialized");
		
		 
//		 Used when required (to view getServletInfo())
//		 System.out.println("Servlet all Info"+getServletInfo());
//		 
//		 System.out.println("Servlet Information: "+config.getServletContext());
//		 
//		 System.out.println("Servlet Other Details: "+config.getServletName());
	}

	
//	2. service()method=> works based on the request type like GET,PUT,POST etc

	@Override
	public void service(ServletRequest req, ServletResponse resp) throws ServletException, IOException {
		resp.setContentType( "text/html");
		PrintWriter out=resp.getWriter();
		
		out.println("<h1>Welcome to Programming with Servlet</h1>");
		out.println("<h3>This program is implemented by Servlet Interface </h3>");
		out.println("<p>I'm Servlet service method</p>");
		
		
		
//		If u need to see every method details in service method
		ServletConfig config=getServletConfig();
		out.println("<h2 style='color:green;'>Servlet Configuration :"+config.getServletContext()+"</h2>");
		out.println("<p></p>");
		out.println("<hr>");
		out.println("<h2 style='color:blue;'>Servlet Information:</h2>");
		out.println("<h3>"+config.getServletName()+"</h3>");
		out.println("<h3>"+getServletInfo()+"</h3>");

		
	}

	
// 3. destroy() - used once in the entire program - terminate servlet
	@Override
	public void destroy() {
		System.out.println("Servlet is terminated ");
		
		  
		
	}

	
//	4. getServletConfig() - returns servlet configuration object
	@Override
	public ServletConfig getServletConfig() {
		  
		return config;
	}
	
//	5. getServletInfo() method - returns information about servlet

	@Override
	public String getServletInfo() {
		 
		return "Now, Servlet is implemented first under Interface method";
	}

